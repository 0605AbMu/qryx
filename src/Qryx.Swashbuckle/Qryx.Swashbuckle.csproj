<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Qryx.Core\Qryx.Core.csproj" />
    <ProjectReference Include="..\Qryx.Expressions\Qryx.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Classic Swashbuckle SwaggerGen operation and parameter filters for Qryx query DTOs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Documentation logic shared with Qryx.OpenApi (linked source, compiled as internal types into each package) -->
  <ItemGroup>
    <Compile Include="..\Qryx.ApiDocs.Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
