<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Qryx.Core\Qryx.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qryx.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>High-performance dynamic expression tree building, AST synthesis, and compiled delegate caching engine for Qryx.</Description>
  </PropertyGroup>

  <!-- Base64Url (keyset cursors) is in the BCL from .NET 9; Microsoft ships the same implementation for .NET 8 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.14" />
  </ItemGroup>

</Project>
