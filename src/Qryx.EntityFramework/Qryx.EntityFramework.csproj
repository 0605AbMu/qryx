<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Entity Framework Core integration for Qryx: keyset cursor pagination, projection pushdown, native ILIKE, and ToPagedResultAsync.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qryx.EntityFramework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qryx.Core\Qryx.Core.csproj" />
    <ProjectReference Include="..\Qryx.Expressions\Qryx.Expressions.csproj" />
  </ItemGroup>

</Project>
